# Kopiera till .env och fyll i. .env får aldrig checkas in i git.

# Anslutningssträngen från Neon (Dashboard → Connect). Behåll ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Signerar inloggningstoken. Använd en lång slumpmässig sträng, t.ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=byt-till-en-lang-slumpmassig-strang

# Vercel Blob (Storage → Blob → din store → .env.local)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Frontendens adress – för CORS. Lokalt: http://localhost:5173
CLIENT_URL=http://localhost:5173

PORT=3000
