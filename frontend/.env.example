# Kopiera till .env.development (lokalt). I Vercel sätts samma variabler under Environment Variables.

# Backendens adress, med /api på slutet
VITE_API_URL=http://localhost:3000/api

# Sajtens namn – byt här för att döpa om appen
VITE_APP_NAME=Wrappd

# Logga in med Google: samma klient-id som GOOGLE_CLIENT_ID i backend. Tomt = ingen Google-knapp.
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
